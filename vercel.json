{
  "framework": "nextjs",
  "buildCommand": "npm run db:generate && next build",
  "crons": [
    {
      "path": "/api/cron/hl-guardian",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/dca",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/spot-guard",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/alerts",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/tradability",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/prints",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    },
    "app/api/live/stream/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/prints/route.ts": {
      "maxDuration": 60
    }
  }
}
