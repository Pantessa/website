{
  "framework": "nextjs",
  "buildCommand": "npm run db:generate && next build",
  "crons": [
    {
      "path": "/api/cron/hl-guardian",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/dca",
      "schedule": "7 * * * *"
    }
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
