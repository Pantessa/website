# ── Database (Prisma / Postgres) ─────────────────────────────────────────────
# Optional. If unset, the app falls back to the static x402 catalog.
DATABASE_URL=postgresql://user:pass@host:5432/yeetful

# ── x402 agent wallet (enables LIVE chat) ────────────────────────────────────
# The server signs x402 payments with this wallet to pay the selected Inference
# and Data MCP endpoints (USDC on Base). Third-party x402 endpoints are
# CORS-locked, so payment happens server-side — not in the browser wallet.
#
# Use a FUNDED BURNER on Base (USDC). Never a wallet holding real funds.
# (You can reuse the burner from the /demo project.)
# Without this, chat runs in demo mode.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Optional: WalletConnect (browser wallet UI via RainbowKit) ───────────────
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID
