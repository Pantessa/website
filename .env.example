# ── Database (Prisma / Postgres) — OPTIONAL, OFF by default ──────────────────
# The app serves the curated in-code x402 catalog (lib/mcp-data.ts) and does
# NOT touch Postgres unless you opt in. To enable the DB (custom servers,
# persistence): set USE_DB=true, fill DATABASE_URL, then run
#   npm run db:push && npm run db:seed
# Leave USE_DB unset/false to run catalog-only (no database required).
USE_DB=false
DATABASE_URL=postgresql://user:pass@host:5432/yeetful

# ── x402 agent wallet (enables LIVE chat) ────────────────────────────────────
# The server signs x402 payments with this wallet to pay the selected Inference
# and Data MCP endpoints (USDC on Base). Third-party x402 endpoints are
# CORS-locked, so payment happens server-side — not in the browser wallet.
#
# Use a FUNDED BURNER on Base (USDC). Never a wallet holding real funds.
# (You can reuse the burner from the /demo project.)
# Without this, chat runs in demo mode.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Optional: WalletConnect (browser wallet UI via RainbowKit) ───────────────
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# ── Optional: Alchemy (multichain wallet splash) ─────────────────────────────
# When set, the connected-wallet portfolio card scans Ethereum, Base, and
# Arbitrum (holdings priced to USD + recent transactions) via the Alchemy Data
# API. Without it, the card falls back to the keyless Base-only on-chain read
# from the uniswap MCP — so it always works, just single-chain.
# One key covers all three chains: https://dashboard.alchemy.com → API Keys.
ALCHEMY_API_KEY=YOUR_ALCHEMY_API_KEY

# ── Optional: Transactional email (Resend) ───────────────────────────────────
# Sends onboarding@yeetful.com mail (verified in Resend via send.yeetful.com).
# Get a key at https://resend.com → API Keys. Without it, sends throw and
# emailConfigured() is false (no crash).
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# Optional overrides:
# EMAIL_FROM="Yeetful <onboarding@yeetful.com>"
# EMAIL_REPLY_TO=nate@yeetful.com

# ── Coinbase CDP Embedded Wallets + social sign-in (Google / Apple / X) ───────
# Server-side CDP credentials (Spend Permissions, server wallet). From the CDP
# Portal → API Keys: https://portal.cdp.coinbase.com
CDP_API_KEY_ID=YOUR_CDP_API_KEY_ID
CDP_API_KEY_SECRET=YOUR_CDP_API_KEY_SECRET
CDP_WALLET_SECRET=YOUR_CDP_WALLET_SECRET
CDP_WALLET_PROJECT_ID=YOUR_CDP_PROJECT_ID
# CDP_SPEND_NETWORK=base-sepolia   # or "base" once a mainnet Smart Account is funded
#
# Client-side project id — REQUIRED for the embedded wallet + email/social sign-in
# (mirrors CDP_WALLET_PROJECT_ID; public, allowlist your domain in the portal).
NEXT_PUBLIC_CDP_PROJECT_ID=YOUR_CDP_PROJECT_ID
#
# Social sign-in (Google, Apple, X) runs through the CDP Embedded Wallet SDK.
# Enable each provider and set its OAuth client id/secret + redirect URIs in the
# CDP Portal (Embedded Wallets → Sign-in methods) — NOT here; the app only needs
# NEXT_PUBLIC_CDP_PROJECT_ID above. The placeholders below are optional, only if
# you register your own provider apps and wire them in the portal:
# GOOGLE_OAUTH_CLIENT_ID=
# APPLE_OAUTH_CLIENT_ID=
# X_OAUTH_CLIENT_ID=
