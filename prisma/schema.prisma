// Pantessa — x402 MCP directory.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector] // pgvector — semantic routing (R2)
}

/// A featured x402 agent/MCP. Ingested from agentic.market (see
/// scripts/ingest-agentic.ts) and enriched for the verified, callable ones.
model McpServer {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String

  category String // Inference | Data | Search | Media | Social | Trading | Infra | Storage | Travel | Other
  kind     String // 'inference' | 'data' — drives chat orchestration

  // Pricing + chains (from agentic.market)
  priceUsd String?  @map("price_usd") // min price per call, e.g. "0.001"
  networks String[] // e.g. ["Base","Solana"] or ["eip155:8453"]

  // false = FREE (non-x402) MCP — no payment gate at the endpoint, calls skip
  // the 402 handshake entirely (still policy-gated + traced + ledgered at $0).
  gated Boolean @default(true)

  // x402 call wiring — only set for callable (verified) services
  callable   Boolean @default(false)
  endpoint   String?
  protocol   String? // 'mcp' | 'http'
  tool       String? // MCP tool name (inference) or wired data tool (mcp data)
  queryParam String? @map("query_param") // primary query param (http data)
  // Default JSON arguments for the wired MCP data `tool`, e.g. {"chains":["ethereum","base"]}.
  // Used by the chat orchestrator to call an MCP *data* service's tool (which
  // takes structured args, not a free-text prompt). Null for inference/http.
  toolArgs   Json?   @map("tool_args")

  // The x402 `payTo` receiver read from this server's wired `endpoint` (lowercased).
  // Whoever controls this wallet operates the server and collects its revenue, so
  // it's the address that can self-claim ownership (see lib/mcp-claim.ts). Backfilled
  // from the live 402 challenge by `npm run db:receivers`; null = unread/unreachable.
  receiver          String?   @map("receiver")
  receiverCheckedAt DateTime? @map("receiver_checked_at")

  // Launchpad (x402-launch): the MCP's token + YeetfulStaking vault, set once a
  // token is launched on the bonding curve. Null = not launched yet. The on-chain
  // YeetfulLaunchFactory is the source of truth; these mirror it for fast reads
  // (fee routing + the per-service token chart). See repo `x402-launch`.
  tokenAddress   String? @map("token_address")
  stakingAddress String? @map("staking_address")

  // Presentation
  iconSlug   String? @map("icon_slug") // Simple Icons brand slug for the glyph
  // A real image logo — an https:// URL or a data: URI (inline SVG/PNG). Takes
  // precedence over iconSlug/lettermark in BrandIcon, so the whole app (detail
  // page, cards, chat rail) renders it. Auto-pulled from the MCP's own
  // serverInfo.icons (MCP spec SEP-973) or the site favicon at add time; the
  // owner can override with an uploaded/linked image.
  logoUrl    String? @map("logo_url")
  color      String?
  websiteUrl String? @map("website_url") // agentic.market service page

  // Capability metadata (R1) — LLM-labeled at ingest (scripts/tag-capabilities.ts)
  // so routing matches on MEANING, not just keyword overlap. `tags` = controlled
  // domain vocab (sports, web-search, transcription…); `exampleQueries` = a few
  // user phrasings this MCP answers. Both folded into the shortlist haystack.
  tags           String[] @default([])
  exampleQueries String[] @default([]) @map("example_queries")

  // Routability report (RR14) — the mcp:lint grader's latest result: overall
  // score, per-dimension breakdown, and the concrete fix list. Written by
  // `npm run mcp:lint -- <slug> --save`; the server page's routability panel
  // reads it. Null = never linted.
  routability Json? @map("routability")

  // Provenance
  source     String   @default("agentic.market")
  featured   Boolean  @default(true)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // The full x402 endpoint surface (one service → many endpoints). The flat
  // endpoint/protocol/tool/queryParam above is the single *wired* call used by
  // the chat orchestrator for callable services; this is the browsable catalog.
  endpoints McpEndpoint[]
  approvals AgentApproval[]

  @@index([category])
  @@index([callable])
  @@map("mcp_servers")
}

/// One callable x402 endpoint of a service (e.g. Claude's POST /v1/messages via
/// Bankr). Descriptive catalog data for the service detail page — services stay
/// the unit of selection in chat; endpoints are never individually selectable.
model McpEndpoint {
  id          String  @id @default(cuid())
  serverId    String  @map("server_id")
  method      String // GET | POST | …
  url         String
  description String?

  // Pricing (USDC). For 'upto' schemes priceUsd is the min and maxPriceUsd the
  // ceiling (e.g. $0.001 – $10.00); for 'exact', priceUsd is the flat amount.
  priceUsd    String? @map("price_usd")
  maxPriceUsd String? @map("max_price_usd")
  scheme      String? // 'exact' | 'upto'
  network     String?
  provider    String? // gateway that serves it (providerName: Venice, Bankr, …)
  position    Int     @default(0) // display order within the service

  /// Structured parameter schemas from agentic.market, when published:
  /// [{ group: 'query'|'path'|'body', name, type, description, example,
  ///    required, enumValues, default }]. Drives the chat planner — an
  /// endpoint with params is auto-callable; without, it's display-only.
  parameters Json?

  /// Provenance of `parameters`: null = from agentic.market ingest, 'inferred' =
  /// LLM-recovered by scripts/infer-params.ts for endpoints agentic.market ships
  /// no schema for. Reversible: set parameters=NULL where params_source='inferred'.
  paramsSource String? @map("params_source")

  /// Owner/admin-flagged "start here" endpoint. Two consumers: the connect-time
  /// quick view pings featured endpoints first for a newly connected wallet
  /// (the generic splash tile for MCPs with no hand-coded source), and the
  /// endpoint planner floats them to the front of its menu as starting hints
  /// when an ask is broad. Set from the add-MCP modal (featuredTools) or the
  /// admin star on /servers/[slug]. Column applied via raw SQL — never
  /// `db push` (drifted harness_results table would be dropped).
  featured Boolean @default(false)

  /// Semantic embedding (R2) of "service + tags + examples + description + path",
  /// from OpenAI text-embedding-3-small (1536-dim). Populated by
  /// scripts/embed-catalog.ts; queried via raw SQL (pgvector `<=>` cosine) in
  /// lib/retrieval.ts. Unsupported in the Prisma client — read/written via $raw.
  embedding Unsupported("vector(1536)")?

  server    McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([serverId, method, url])
  @@index([serverId])
  @@map("mcp_endpoints")
}

/// Free-probe liveness results (scripts/harness-probe.ts writes, lib/health.ts
/// reads — both via RAW SQL; the table historically self-bootstrapped outside
/// this schema, which made `prisma db push` propose DROPPING it (caught
/// 2026-07-06, 1865 rows). Declared here so push sees it as in-sync; keep the
/// column shapes matching the bootstrap DDL in harness-probe.ts exactly.
model HarnessResult {
  id          String   @id
  endpointId  String   @map("endpoint_id")
  service     String?
  method      String?
  url         String?
  httpStatus  Int?     @map("http_status")
  status      String
  priceUsd    Float?   @map("price_usd")
  scheme      String?
  network     String?
  payTo       String?  @map("pay_to")
  x402Version Int?     @map("x402_version")
  errorReason String?  @map("error_reason")
  latencyMs   Int?     @map("latency_ms")
  probedAt    DateTime @default(now()) @map("probed_at") @db.Timestamp(6)

  @@index([endpointId])
  @@index([status])
  @@map("harness_results")
}

/// A user's rating of an MCP service — the human signal in the reputation score
/// (alongside the automated reliability/liveness/speed/adoption/value metrics).
/// One rating per wallet per service (upsert to change). Keyed by service SLUG
/// so it survives a service rename. Bayesian-averaged in lib/reputation so a
/// single vote can't swing a score.
model McpRating {
  id           String   @id @default(cuid())
  serviceSlug  String   @map("service_slug")
  ownerAddress String   @map("owner_address") // SIWE wallet that rated
  rating       Int // 1–5 stars
  review       String? // optional short note
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([serviceSlug, ownerAddress])
  @@index([serviceSlug])
  @@map("mcp_ratings")
}

/// Who owns/operates an MCP, for the launchpad (repo x402-launch). The claimant
/// proves control of the MCP's backing GitHub repo by committing
/// `.well-known/yeetful-claim.txt` containing their wallet address, and proves
/// the wallet via SIWE. One owner per MCP. This owner is the creator-of-record
/// for the MCP's token (the on-chain creator/treasury) and, once a token
/// launches, the recipient of the creator fee split. Until claimed, that cut
/// escrows on-chain (YeetfulStaking.treasury).
model McpOwner {
  id           String   @id @default(cuid())
  mcpSlug      String   @unique @map("mcp_slug") // the claimed McpServer.slug
  ownerAddress String   @map("owner_address") // lowercased, SIWE-verified
  /// How ownership was proven. 'receiver' = signed in with the wallet the MCP's
  /// x402 `payTo` is set to (read from its own 402 challenge — proves control of
  /// the account that collects the MCP's revenue). 'admin' = a Pantessa admin
  /// verified it (endpoint unreadable / shared-gateway payee / Pantessa's own).
  verifiedVia  String   @default("receiver") @map("verified_via")
  /// The endpoint host ownership was checked against (e.g. anthropic.yeetful.com).
  verifiedHost String?  @map("verified_host")
  repo         String? // optional: link to the MCP's source repo (display only, NOT the proof)
  githubLogin  String?  @map("github_login")
  claimedAt    DateTime @default(now()) @map("claimed_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([ownerAddress])
  @@map("mcp_owners")
}

/// Earn-side ledger: one row per paid call an MCP *served* (the payee side of the
/// control plane, mirroring SpendLedgerEntry on the payer side). Reported by the
/// MCP itself via POST /api/mcp/receipts (Bearer key → must own the slug), so it's
/// self-reported telemetry for rich/real-time analytics — on-chain receiver
/// activity is the trust layer. ownerAddress is denormalized (lowercased) so
/// earnings are queryable per wallet and survive a re-claim.
model McpReceipt {
  id           String    @id @default(cuid())
  mcpSlug      String    @map("mcp_slug") // the McpServer.slug that served the call
  ownerAddress String    @map("owner_address") // payee wallet at report time (lowercased)
  payer        String? // the paying agent's wallet (lowercased), if the MCP reports it
  amountUsd    Float     @map("amount_usd")
  tool         String? // MCP tool / resource the call hit (display)
  network      String? // e.g. "base"
  txHash       String?   @unique @map("tx_hash") // unique ⇒ a settlement tx is counted once
  apiKeyId     String?   @map("api_key_id") // which key reported it
  /// On-chain verification (the trust layer). null = not checked / no txHash to
  /// check; true = a USDC transfer to the MCP's payTo backing ≥ the claimed
  /// amount was found on-chain; false = a txHash was given but contradicts the
  /// claim (a red flag — self-report not backed by settlement).
  verified     Boolean?  @map("verified")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([mcpSlug, createdAt])
  @@index([ownerAddress, createdAt])
  @@map("mcp_receipts")
}

/// A chat owned by a wallet address (verified via SIWE — see lib/auth.ts).
/// Private by default; the owner can opt in to a public, unlisted share link
/// (publicSlug). The sharing UI lands in a later branch — the schema is ready.
model Chat {
  id           String @id @default(cuid())
  title        String @default("New chat")
  ownerAddress String @map("owner_address") // lowercased, SIWE-verified

  // Selected x402 agents for this chat (slugs/ids), so a reopened chat
  // restores its active set.
  activeServerIds String[] @map("active_server_ids")

  // Opt-in public sharing. isPublic flips it on; publicSlug is the unguessable
  // id used in the share URL (/p/<publicSlug>); publicAt is when it was shared.
  isPublic   Boolean   @default(false) @map("is_public")
  publicSlug String?   @unique @map("public_slug")
  publicAt   DateTime? @map("public_at")

  messages   Message[]
  // Our own harness/drill chat (lib/internal-run.ts): the GTM arc reads
  // chats + messages as "arrived"/"asked"/"built"/"signed" — a gate run's
  // fixture chats must never move a stage. Messages inherit via the join.
  isInternal Boolean   @default(false) @map("is_internal")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([ownerAddress])
  @@index([isInternal])
  @@map("chats")
}

model Message {
  id      String @id @default(cuid())
  chatId  String @map("chat_id")
  role    String // 'user' | 'assistant'
  content String
  /// optional per-turn metadata (e.g. x402 payment receipts)
  meta    Json?

  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([chatId])
  @@map("messages")
}

/// A company workspace: shared agents, keys, budgets, and ledger under one
/// roof. Membership is wallet-native — adding an address IS the invite (it
/// takes effect on the invitee's next SIWE sign-in; no email machinery).
/// Org-scoped rows on the spending tables carry org_id; NULL = personal
/// scope, so every pre-org row keeps working unchanged.
model Organization {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  createdBy String @map("created_by") // lowercased wallet of the founder

  /// Org-level daily cap (USD) across ALL the org's agent keys — the level
  /// above per-key budgets. Null = no org cap. Advisory at the rails
  /// (SDK-enforced via /api/agent/policy) until Coinbase Spend Permissions.
  perDayUsd Float? @map("per_day_usd")

  members   OrgMember[]
  apiKeys   ApiKey[]
  grants    SpendGrant[]
  approvals AgentApproval[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

/// One wallet's membership in an org. Roles: owner > admin > member —
/// the matrix lives in lib/org.ts (requireRole), enforced server-side in
/// every org route; a Bearer key can NEVER manage membership (SIWE only).
model OrgMember {
  id      String  @id @default(cuid())
  orgId   String  @map("org_id")
  address String // lowercased wallet
  role    String  @default("member") // owner | admin | member
  addedBy String? @map("added_by") // lowercased wallet that sent the invite

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([orgId, address])
  @@index([address])
  @@map("org_members")
}

/// An "agent expense account": a scoped, wallet-owned authorization to pay x402
/// endpoints up to a budget. It's POLICY, not custody — Pantessa enforces the
/// caps + allowlist and ledgers every decision; the funds move from the payer
/// (today the house burner; later a Coinbase Spend Permission / session key
/// scoped to this grant) straight to the seller. See lib/spend-grant.ts.
model SpendGrant {
  id           String  @id @default(cuid())
  ownerAddress String  @map("owner_address") // lowercased, SIWE-verified
  /// Org scope; NULL = the owner's personal expense account (pre-org rows
  /// all have NULL — back-compat by construction).
  orgId        String? @map("org_id")
  label        String  @default("Agent expense account")

  /// Exact hostnames this grant may pay (e.g. "tripadvisor.x402.paysponge.com").
  allow String[]

  /// Hosts the owner allowed DIRECTLY (e.g. a native venue's policy host from
  /// a blocked-swap fix-it). `allow` is re-DERIVED from agent approvals on
  /// every toggle (lib/approvals syncGrantAllowlist), which would silently
  /// wipe an ad-hoc allow — so direct allows persist here and the sync unions
  /// them back in.
  extraAllow String[] @default([]) @map("extra_allow")

  /// Caps in USD. perDay resets at local midnight (UTC); total is a lifetime cap.
  perCallUsd Float  @map("per_call_usd")
  perDayUsd  Float  @map("per_day_usd")
  totalUsd   Float? @map("total_usd")

  expiresAt DateTime @map("expires_at")
  status    String   @default("active") // active | revoked | expired
  /// Kill switch: a reversible freeze of the whole expense account (distinct
  /// from status:revoked, which is permanent and drops the grant from
  /// getActiveGrant). When true, every chat path Pantessa executes HARD-refuses
  /// with ACCOUNT_FROZEN and /api/agent/policy reports halted; the SDK refuses
  /// too. Toggled SIWE-only (owner / org admin).
  paused    Boolean  @default(false) @map("paused")

  /// Master power switch for the spend policy. Default OFF so a new user's
  /// first run is unrestricted (the policy is otherwise a big trial blocker).
  /// When false, checkGrant() short-circuits — no allowlist, no caps, any host.
  /// Independent of `paused` and of the per-agent approval rows (flipping this
  /// never mutates agent_approvals, so a curated allowlist survives a toggle).
  /// Existing grants are backfilled to true to preserve current behavior.
  spendPolicyEnabled Boolean @default(false) @map("spend_policy_enabled")

  /// EIP-712 signature of the grant terms. Null while grants are SIWE-session
  /// gated; populated once wallet-signed approvals are wired (then this is the
  /// portable authorization artifact / precursor to an on-chain Spend Permission).
  signature String?

  /// Coinbase Spend Permission backing this grant on-chain — the hard stop the
  /// advisory pause/budget points at. Null = SDK-advisory only. When set, the
  /// grant's per-day cap is mirrored by an on-chain SpendPermission (allowance
  /// over a 1-day period) on a CDP Smart Account, so the wallet contract caps
  /// spend regardless of the SDK. `Id` = the CDP permission id / userOp hash;
  /// `Network` = 'base' | 'base-sepolia'. Drives the "Backed on-chain" badge.
  spendPermissionId      String? @map("spend_permission_id")
  spendPermissionNetwork String? @map("spend_permission_network")

  org       Organization?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ledger    SpendLedgerEntry[]
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([ownerAddress])
  @@index([orgId])
  @@index([status])
  @@map("spend_grants")
}

/// Append-only record of every authorization decision under a grant — the audit
/// trail, the budget data, and the x402 payment receipts in one table.
model SpendLedgerEntry {
  id          String  @id @default(cuid())
  grantId     String  @map("grant_id")
  host        String
  /// Directory service the call belonged to (e.g. "Yeetful · Claude") — lets
  /// the dashboard chart per-agent without reverse-mapping hosts.
  serviceName String? @map("service_name")
  amountUsd   Float   @map("amount_usd")
  ok          Boolean
  txHash      String? @map("tx_hash")
  note        String? // "settled" | "dry-run" | a GrantViolation code
  /// Round-trip latency of the paid call in ms (settle time), when measured —
  /// feeds the per-MCP "speed" reputation sub-score. Null on older rows / blocks.
  latencyMs   Int?    @map("latency_ms")
  /// Which connected agent (API key) synced this receipt — set when the entry
  /// arrives via Bearer auth, so spend is attributable per agent.
  apiKeyId    String? @map("api_key_id")
  /// Denormalized org attribution (no FK — audit rows must outlive nothing;
  /// the grant relation already cascades them). NULL = personal spend.
  orgId       String? @map("org_id")

  grant     SpendGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  apiKey    ApiKey?    @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([grantId])
  @@index([grantId, ok, createdAt])
  // Per-agent spent-today (the Agents tab + /api/agent/policy).
  @@index([apiKeyId, ok, createdAt])
  // Org spent-today (the two-level budget + the expense report).
  @@index([orgId, ok, createdAt])
  // Global public feed (/api/activity) scans newest-first across ALL grants.
  @@index([ok, createdAt])
  @@map("spend_ledger")
}

/// One auto-routed turn's decision + outcome — the routing engine's telemetry
/// (B14), so routing quality is observable over time. Privacy: NO full wallet,
/// NO raw question — engine-derived intent + service slugs only, mirroring the
/// /api/activity P1/P2 posture. Aggregated by /api/route/metrics.
model RouteEvent {
  id           String   @id @default(cuid())
  intent       String? // short engine intent, NOT the raw user question
  shortlisted  Int      @default(0) // candidate tools considered after retrieve→plan
  picks        Json? // [{ service, endpoint?, priceUsd }] chosen this turn
  settledCount Int      @default(0) @map("settled_count")
  failedCount  Int      @default(0) @map("failed_count")
  cachedCount  Int      @default(0) @map("cached_count")
  totalCostUsd Float    @default(0) @map("total_cost_usd")
  savedUsd     Float    @default(0) @map("saved_usd")
  latencyMs    Int      @default(0) @map("latency_ms")
  payer        String?
  blocked      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("route_events")
}

/// A deduplicated routing FAILURE — the self-heal loop's unit of work. Grouped
/// by `signature` (service + error class, e.g. "heurist-mesh:404") so repeated
/// failures of the same kind collapse into ONE incident with a count, not N
/// alerts. The state machine (open → dispatched → pr_open → resolved) is what
/// stops the autonomous fixer from firing twice for the same bug. `exampleTurnId`
/// links to the failing turn's full trace (route_trace_lines) — the "what the
/// user tried + what they got" the fix PR cites.
model RouteIncident {
  id            String    @id @default(cuid())
  signature     String    @unique // "<service-slug>:<errorClass>"
  service       String? // serviceName/host that failed
  errorClass    String?   @map("error_class") // "404" | "400" | "unresolved-path" | "settlement" | "timeout" | "error"
  title         String // human summary
  status        String    @default("open") // open | dispatched | pr_open | resolved | wontfix
  count         Int       @default(0)
  exampleTurnId String?   @map("example_turn_id") // a route_trace_lines turnId to view the trace
  lastError     String?   @map("last_error") // last error message (capped)
  prUrl         String?   @map("pr_url")
  firstSeenAt   DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  resolvedAt    DateTime? @map("resolved_at")

  @@index([status])
  @@index([lastSeenAt])
  @@map("route_incidents")
}

/// One directory toggle: a user flipped an agent into (`active=true`) or out of
/// (`active=false`) their chat runner. This mirrors the `agent_added` /
/// `agent_removed` Vercel Analytics events (lib/analytics.ts) into our own DB so
/// the admin adoption view can rank which agents get picked — data Vercel won't
/// hand back by slug. Privacy: NO full wallet — `address` is a lowercased wallet
/// when signed in, else null (guest toggles still count). Fire-and-forget write
/// (POST /api/agents/toggle); a failure never blocks the toggle.
model AgentToggleEvent {
  id        String   @id @default(cuid())
  slug      String // the McpServer.slug toggled (no FK: guests toggle static-catalog slugs too)
  active    Boolean // true = added to runner, false = removed
  address   String? // lowercased wallet if signed in, else null
  /// Our own harness/drill toggle (lib/internal-run.ts) — arrival hygiene.
  isInternal Boolean @default(false) @map("is_internal")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([slug])
  @@index([createdAt])
  @@map("agent_toggle_events")
}

/// One line of a routed turn's live reasoning trace — the public, realtime
/// stream behind the Activity page's routing terminal (and the chat engine
/// window). Unlike RouteEvent (one aggregate row per turn), this is the raw
/// line-by-line trace so a viewer can watch the engine think + pay in real time.
/// Privacy: SAME posture as /api/activity — engine-derived intent, service
/// slugs, prices, and public tx hashes only; NEVER a wallet or the raw question.
/// Written fire-and-forget from the chat SSE chokepoint (lib/route-trace.ts).
/// Local + prod share one Neon DB, so local test turns stream to prod too.
model RouteTraceLine {
  // Autoincrement so the public live feed can page with a simple `?since=<n>`
  // cursor (createdAt has ties within a turn).
  n         Int      @id @default(autoincrement())
  turnId    String   @map("turn_id") // groups the lines of one routed turn
  seq       Int      @default(0) // order within the turn
  type      String // status|analyze|shortlist|candidate|select|pay|receipt|tool|eip712|note|error
  event     Json // the RouterTraceEvent payload (matches lib/store RouterTraceEvent)
  txHash    String?  @map("tx_hash") // settled tx (receipt events) → BaseScan link
  payer     String? // 'burner' | 'agent' | 'wallet' | null
  createdAt DateTime @default(now()) @map("created_at")

  @@index([turnId])
  @@index([createdAt])
  @@map("route_trace_lines")
}

/// A bearer credential for headless agents (the `yeetful` SDK, scripts, CI).
/// The plaintext secret (`yf_…`) is shown ONCE at mint and only its sha256 is
/// stored; presenting it as `Authorization: Bearer yf_…` authenticates the
/// owner wallet on /api/grants* the same way a SIWE session cookie does.
model ApiKey {
  id           String    @id @default(cuid())
  ownerAddress String    @map("owner_address") // lowercased, SIWE-verified at mint
  /// Org scope; NULL = a personal key. Org keys are minted/managed by org
  /// admins and their spend rolls up to the org's daily cap.
  orgId        String?   @map("org_id")
  label        String    @default("API key")
  /// sha256 hex digest of the full plaintext secret.
  hash         String    @unique
  /// Display handle: the first 11 chars of the secret ("yf_" + 8), so the
  /// dashboard can say "yf_a1b2c3d4…" without storing anything recoverable.
  prefix       String
  /// Per-agent daily budget in USD. A key IS a connected agent (an app using
  /// the yeetful SDK); null = no agent-level budget, the grant alone governs.
  /// Advisory at the rails (the agent pays from its own wallet) — enforced by
  /// the SDK via /api/agent/policy and flagged on over-budget receipt syncs.
  perDayUsd    Float?    @map("per_day_usd")
  /// Kill switch: a reversible freeze (distinct from revoke = DELETE). When
  /// true, /api/agent/policy reports halted=AGENT_PAUSED and the SDK refuses
  /// all payments. Toggled SIWE-only (owner / org admin) — never by the key.
  paused       Boolean   @default(false)
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  org    Organization?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ledger SpendLedgerEntry[]

  @@index([ownerAddress])
  @@index([orgId])
  @@map("api_keys")
}

/// Per-wallet agent approval — the dashboard's "which agents may my account
/// pay" spec. Toggling syncs the owner's active SpendGrant allowlist (the
/// hosts of the approved services), so a toggle IS enforcement, not décor.
model AgentApproval {
  id           String  @id @default(cuid())
  ownerAddress String  @map("owner_address") // lowercased, SIWE-verified
  /// Org scope; NULL = personal. NOTE for item 2 (org-scoped approvals):
  /// the @@unique below must widen to [ownerAddress, serverId, orgId] when
  /// org approvals land, or a member's personal toggle collides with their
  /// org toggle for the same server. Left untouched here — item 1 is
  /// column-additive only.
  orgId        String? @map("org_id")
  serverId     String  @map("server_id")
  approved     Boolean @default(true)

  server    McpServer     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([ownerAddress, serverId])
  @@index([ownerAddress])
  @@index([orgId])
  @@map("agent_approvals")
}

/// A wallet's curated MCP shortlist — the 1–3 services they want to talk to
/// (the "pick your tools" direction). One row per wallet. Distinct from
/// AgentApproval (which agents may be *paid*) and from Chat.activeServerIds
/// (per-chat working set): the shortlist is the saved default that seeds a new
/// chat's active set. Empty / absent = no shortlist → current whole-catalog
/// behavior. Enforced ≤3 at the write layer (lib/shortlist.ts).
model McpShortlist {
  id           String   @id @default(cuid())
  ownerAddress String   @unique @map("owner_address") // lowercased, SIWE-verified
  serviceIds   String[] @map("service_ids") // McpServer ids, ordered, ≤3
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("mcp_shortlists")
}

/// A wallet's last chat working set — the full active MCP set from the bare
/// /chat surface, so a signed-in user's set follows them across devices (the
/// localStorage cache in store.walletSets is same-browser only; this is its
/// DB mirror). Written through on every change, restored on connect; the DB
/// copy wins over the local cache when signed in. Unlike McpShortlist there
/// is NO size cap — this records whatever the user last had toggled on.
/// Guests stay localStorage-only. One row per wallet.
model WalletWorkingSet {
  id           String   @id @default(cuid())
  ownerAddress String   @unique @map("owner_address") // lowercased, SIWE-verified
  serviceIds   String[] @map("service_ids") // McpServer ids, ordered
  isInternal   Boolean  @default(false) @map("is_internal") // our own harness/drill run (lib/internal-run.ts) — the GTM arc's arrival tables exclude it
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isInternal])
  @@map("wallet_working_sets")
}

/// A blog post — Neon holds the metadata + markdown; images live in Vercel
/// Blob (URLs only here). Published via the admin API (SIWE session or Bearer
/// yf_… key ∩ ADMIN_WALLETS) — the headless path Claude publishes through.
/// description doubles as the SEO meta description (keep ≤160 chars);
/// coverImageAlt exists because images without alt text don't rank.
model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  description   String
  content       String // markdown — rendered with raw HTML escaped
  coverImageUrl String?   @map("cover_image_url")
  coverImageAlt String?   @map("cover_image_alt")
  tags          String[]
  published     Boolean   @default(false)
  publishedAt   DateTime? @map("published_at")
  authorAddress String    @map("author_address") // lowercased admin wallet
  views         Int       @default(0) // page loads — bumped by POST /api/blog/[slug]/view
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([published, publishedAt])
  @@map("blog_posts")
}

// Landing-page "stay up to date" signups. Double opt-in: a row starts `pending`
// with a verification token emailed to the address; clicking the link flips it
// to `verified` (that's how we confirm the email is real).
model Subscriber {
  id         String    @id @default(cuid())
  email      String    @unique
  status     String    @default("pending") // 'pending' | 'verified'
  token      String    @unique // single-use verification token
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("subscribers")
}

// Price history for a launched MCP token's chart. There's no on-chain price
// history and Flaunch's OHLC API is unreliable, so we sample the v4-pool spot
// price ourselves (Flaunch SDK) and append a point — throttled — when the price
// endpoint is read. The chart reads this series.
model TokenPriceSample {
  id           String   @id @default(cuid())
  mcpSlug      String   @map("mcp_slug") // the launched McpServer.slug
  priceEth     String   @map("price_eth") // full-precision spot price (token in ETH)
  priceUsd     Float    @map("price_usd")
  marketCapUsd Float    @map("market_cap_usd")
  at           DateTime @default(now())

  @@index([mcpSlug, at])
  @@map("token_price_samples")
}

/// A wallet's paid plan (Stripe monthly billing). One row per owner address;
/// no row = the free tier. Stripe is the source of truth — rows are written
/// by the checkout/webhook flow (app/api/billing/*), never by hand.
model Subscription {
  id                   String    @id @default(cuid())
  ownerAddress         String    @unique @map("owner_address")
  plan                 String    @default("free") // PlanId: 'free' | 'growth' | 'scale'
  status               String    @default("active") // Stripe subscription status
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  currentPeriodEnd     DateTime? @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("subscriptions")
}

/// YEET credit movements — the inference token, ledgered off-chain today and
/// intended to become an ERC-20. Negative delta = spend (one house-model
/// answer), positive = a grant/top-up. The monthly plan allowance is NOT
/// ledgered: usage for a period is the sum of that period's debits, so the
/// allowance resets by construction each calendar month (UTC).
model CreditLedgerEntry {
  id           String   @id @default(cuid())
  ownerAddress String   @map("owner_address")
  delta        Int
  reason       String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([ownerAddress, createdAt])
  @@map("credit_ledger")
}

/// A PUBLIC embed key (`yfe_…`) — safe to ship in a host page's source, like
/// a Stripe publishable key. It does ONE thing: attributes embedded-chat
/// traffic (sites + YEET credit spend) to the owning account's plan. It is
/// NOT a bearer credential — it can read nothing and spend nothing beyond
/// metering the owner's own allowance. Minted/revoked from the dashboard.
model EmbedKey {
  id           String   @id @default(cuid())
  key          String   @unique // yfe_ + hex, stored plaintext (public by design)
  ownerAddress String   @map("owner_address")
  label        String   @default("")
  revoked      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([ownerAddress])
  @@map("embed_keys")
}

/// One row per (embed key, origin) that has mounted the chat — the "who has
/// embedded us where" ledger. Keyless embeds land under embedKeyId '' so the
/// adoption surface still sees anonymous origins. `pageUrl` keeps the most
/// recent full URL the SDK reported (referrer policy permitting); `turns`
/// counts chat messages sent from that origin.
model EmbedSite {
  id           String   @id @default(cuid())
  embedKeyId   String   @default("") @map("embed_key_id") // '' = keyless
  ownerAddress String?  @map("owner_address") // denormalized from the key
  origin       String
  pageUrl      String?  @map("page_url")
  turns        Int      @default(0)
  firstSeen    DateTime @default(now()) @map("first_seen")
  lastSeen     DateTime @default(now()) @map("last_seen")

  @@unique([embedKeyId, origin])
  @@index([ownerAddress])
  @@map("embed_sites")
}

/// One row per KEYED embedded-chat turn — the observability spine for the
/// self-healing loop. Records what visitors asked on a host site, what the
/// agent did about it (outcome), any transaction artifact it built, and the
/// explorer link once something was signed. Sessions (one id per embed
/// mount) make dead-end conversations computable: a session whose goal was
/// a transaction but that never reached tx-built/signed is the signal that
/// feeds "upgrade your MCP" suggestions. Keyless embeds record nothing —
/// telemetry is a feature OF the key — with ONE exception: first-party
/// yeetful.com chat records its VALUE-BEARING outcomes (tx-built / signed)
/// under embedKeyId '' with no prompt, so "money moved" counts the whole
/// product, not just embeds. `valueUsd` is the guardrail layer's notional
/// USD for the built transaction (best-effort — null when unpriceable).
model EmbedTurn {
  id             String   @id @default(cuid())
  embedKeyId     String   @map("embed_key_id")
  ownerAddress   String?  @map("owner_address")
  origin         String
  sessionId      String   @map("session_id")
  prompt         String   @default("") // the visitor's ask, capped client+server side
  outcome        String // answered | clarify | tx-built | signed | refused | credit-gate | error
  artifact       String? // cow-order | tx | tx-chain | vote
  chain          String? // 'base' | 'ethereum' | a hex chainId — best-effort from the artifact
  detail         String? // short refusal/error text, or a human label for the artifact
  txUrl          String?  @map("tx_url") // explorer link once signed/placed
  valueUsd       Float?   @map("value_usd") // notional USD of the built/signed tx (guardrail-priced)
  buildPath      String?  @map("build_path") // which layer built the artifact: native-* | planner | manual (lib/build-path.ts)
  originKind     String?  @map("origin_kind") // chat | embed | job-step | dca-run (lib/value-origin.ts) — attended vs standing; null = legacy row, classified at read time
  intentLinkSlug String?  @map("intent_link_slug") // /i/<slug> attribution — creator fee-split accrues on fee-bearing signed turns
  walletAddress  String?  @map("wallet_address") // the SIGNING wallet (lowercased, self-reported like the rest of the beacon) — lifetime referral earnings key off it; null = legacy row
  feeBps         Int?     @map("fee_bps") // the fee tier the ARTIFACT actually carried (C2b: 20 organic / 50 link) — earnings read this over the per-path default; null = legacy row at the path rate
  isInternal     Boolean  @default(false) @map("is_internal") // our own drill/harness traffic — stamped at the write site (x-yf-internal-run header / internalRun body / harness- sessionId); origin patterns can't catch prod-pointed runs, so every scoreboard read excludes this too (lib/value-origin.ts)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([ownerAddress, createdAt])
  @@index([embedKeyId, createdAt])
  @@index([sessionId, createdAt])
  @@index([walletAddress, createdAt])
  @@map("embed_turns")
}

// First-touch lifetime referral (HANDOFF-yeetcall-gtm C2): the FIRST link a
// wallet ever signs through claims that wallet for its creator, forever —
// later fee-bearing turns by the wallet WITHOUT a direct link attribution
// accrue to this creator (direct intentLinkSlug attribution always wins
// per-turn). One row per wallet, written once, never updated.
model ReferredWallet {
  wallet         String   @id // lowercased signer
  creator        String // lowercased creator wallet (from the link at stamp time)
  intentLinkSlug String   @map("intent_link_slug") // the claiming link
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([creator])
  @@map("referred_wallets")
}

/// One chat turn that ENDED IN A WALL on a money-shaped ask — no signable
/// artifact, no job, no chips — plus a best-effort funds snapshot taken at
/// the moment of failure. `had_funds = true` rows are the product-gap queue:
/// the user held movable money somewhere and the ladder/planner offered no
/// path to use it (the 2026-07-23 NFT buy: 0.007 ETH short on Base while
/// Hourly unsigned-turn counters (lib/turn-limits.ts) — the abuse fence in
/// front of connect-to-act link traffic. key = `i:<ip-hash>` | `w:<wallet>`;
/// rows are lazily swept after their window ages out.
model UnsignedTurnWindow {
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(0)

  @@id([key, windowStart])
  @@map("unsigned_turn_windows")
}

/// $19 of USDC sat on Base+Arbitrum). Written by the chat route's response
/// wrapper (lib/ask-failure.ts); read by /dashboard/failures (admin).
model AskFailure {
  id          String   @id @default(cuid())
  wallet      String?
  prompt      String // capped server-side
  reply       String? // what the user actually saw, capped
  kind        String // planner-answer | native-wall | blocked | error
  buildPath   String?  @map("build_path")
  hadFunds    Boolean? @map("had_funds") // null until the async scan lands
  /// Our own harness/drill wall (lib/internal-run.ts): prod-pointed drills
  /// that don't opt out with x-yf-no-ask-log still write rows — stamped, so
  /// /dashboard/failures hides them by default (a drill's wall is not a
  /// stranger's wall).
  isInternal  Boolean  @default(false) @map("is_internal")
  fundsUsd    Float?   @map("funds_usd") // movable USD seen across scanned chains
  fundsDetail String?  @map("funds_detail") // human per-chain summary
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([hadFunds, createdAt])
  @@index([isInternal, createdAt])
  @@map("ask_failures")
}

/// One Hyperliquid agent-wallet delegation: the user's one-time approveAgent
/// signature authorizing a Pantessa-held agent key to TRADE their HL account
/// (the venue bars agent keys from withdrawing — custody stays with the
/// user). The key is generated per delegation and stored AES-256-GCM
/// encrypted (GUARDIAN_KEY_SECRET); expiry is venue-enforced via the
/// `valid_until` agentName suffix and mirrored here. See lib/hl-guardian*.
model HlGuardianDelegation {
  id           String    @id @default(cuid())
  wallet       String // master account, lowercased, SIWE-verified
  agentAddress String    @map("agent_address")
  agentKeyEnc  String    @map("agent_key_enc") // v1:<iv>:<tag>:<ct> AES-256-GCM
  hlChain      String    @default("Mainnet") @map("hl_chain") // Mainnet | Testnet
  status       String    @default("pending") // pending | active | revoked | expired
  /// approveAgent action nonce (ms timestamp) — kept so the submitted action
  /// re-derives EXACTLY what the user signed.
  nonce        BigInt
  sigChainId   Int       @map("sig_chain_id") // EIP-712 domain chainId the wallet signed under
  approvedAt   DateTime? @map("approved_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  policies HlGuardianPolicy[]

  @@index([wallet])
  @@map("hl_guardian_delegations")
}

/// One armed guardian policy: close a pinned position when its trigger
/// crosses. Params are fixed by the USER at arm time; the sweep derives
/// side/size/price from the live position and the guard refuses anything
/// that is not a reduce-only close of this coin.
model HlGuardianPolicy {
  id           String    @id @default(cuid())
  delegationId String    @map("delegation_id")
  wallet       String
  coin         String // HL perp symbol, e.g. "SYRUP"
  side         String // long | short (the position being guarded)
  kind         String // stop_loss | take_profit
  triggerMode  String    @map("trigger_mode") // price_move_pct | price
  triggerValue Float     @map("trigger_value")
  status       String    @default("active") // active | paused | triggered | done | error
  lastChecked  DateTime? @map("last_checked")
  /// Our own harness/drill policy (lib/internal-run.ts) — arrival hygiene.
  isInternal   Boolean   @default(false) @map("is_internal")
  createdAt    DateTime  @default(now()) @map("created_at")

  delegation HlGuardianDelegation @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  runs       HlGuardianRun[]

  @@index([status])
  @@index([wallet, createdAt])
  @@map("hl_guardian_policies")
}

/// Append-only receipt trail: every consequential guardian decision — the
/// exact guarded action, the verbatim guard report, the venue response, and
/// the closed notional (money-moved value of the protective close).
model HlGuardianRun {
  id          String   @id @default(cuid())
  policyId    String   @map("policy_id")
  wallet      String
  action      String // closed | retry | blocked | error | skipped_kill | noop_position_gone
  reason      String
  orderJson   Json?    @map("order_json")
  guardReport Json?    @map("guard_report")
  hlResponse  Json?    @map("hl_response")
  valueUsd    Float?   @map("value_usd")
  createdAt   DateTime @default(now()) @map("created_at")

  policy HlGuardianPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, createdAt])
  @@index([wallet, createdAt])
  @@map("hl_guardian_runs")
}

/// A multi-step job: one user intent compiled into a FIXED sequence of
/// guarded steps across venues (sign / wait / auto), executed by the jobs
/// cron. The orchestration primitive from HANDOFF-multistep-jobs.md — jobs
/// never widen authority, they only sequence consents the user already gave.
model Job {
  id          String   @id @default(cuid())
  wallet      String // lowercased owner (SIWE-verified at creation)
  title       String // human summary of the whole job
  source      String   @default("chat") // chat | api
  status      String   @default("running") // running | waiting_signature | waiting_settlement | paused | done | failed | canceled
  currentStep Int      @default(0) @map("current_step")
  /// Shared-DB env fence (the guardian lesson): only the creating env's
  /// runner advances a job. 'production' | 'preview' | 'dev'.
  originEnv   String   @default("dev") @map("origin_env")
  /// Our own harness/drill run (lib/internal-run.ts) — stamped at createJob;
  /// the GTM arc never counts a stamped job as an arrival, build, or sign.
  isInternal  Boolean  @default(false) @map("is_internal")
  valueUsd    Float?   @map("value_usd") // rollup of step notionals (money moved)
  failReason  String?  @map("fail_reason")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  steps JobStep[]

  @@index([wallet, createdAt])
  @@index([status])
  @@index([isInternal, originEnv])
  @@map("jobs")
}

/// One step of a job. kind:
///  · sign — a guarded artifact the USER's wallet signs (built fresh at
///    offer time; the chat card embeds the existing sign buttons)
///  · wait — a settlement predicate the runner polls (1Click status, HL
///    credit, balance ≥) — waits ARE the verification layer
///  · auto — a server-side action under an EXISTING consent (guardian arm)
model JobStep {
  id            String    @id @default(cuid())
  jobId         String    @map("job_id")
  seq           Int
  kind          String // sign | wait | auto
  status        String    @default("pending") // pending | offered | running | done | failed | skipped
  builder       String // build_path-style attribution (native-cross-chain | native-hl-exec | native-hl-guardian | wait)
  title         String // human step title for the card
  params        Json // FIXED build inputs (compiled from the ask, never re-planned)
  artifact      Json? // built at offer time (sign steps)
  guardReport   Json?     @map("guard_report")
  result        Json? // txHash / fill / settlement proof / arm receipt
  valueUsd      Float?    @map("value_usd")
  waitPredicate Json?     @map("wait_predicate")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, seq])
  @@index([jobId])
  @@map("job_steps")
}

/// A recurring buy (DCA): spend a fixed $ of the chain's primary stable on a
/// token once per calendar period (UTC day/week/month). CONFIRM-MODE by
/// design — nothing signs itself. When a period is due, chat/splash offer a
/// one-tap chip that compiles a ONE-STEP job (the same native-swap builder +
/// guardrails as any swap), so every buy is built fresh at offer time and
/// individually signed. Missed periods lapse silently — no catch-up buys.
model DcaSchedule {
  id         String   @id @default(cuid())
  wallet     String // lowercased owner (connected wallet at creation)
  status     String   @default("active") // active | paused | canceled
  /// Shared-DB env fence (the guardian/jobs lesson): schedules only surface
  /// and run in the env that created them. 'production' | 'preview' | 'dev'.
  originEnv  String   @default("dev") @map("origin_env")
  cadence    String // day | week | month (UTC calendar periods)
  buyUsd     Float    @map("buy_usd")
  buyToken   String   @map("buy_token") // symbol — resolved per-build from the chain's official token list
  sellToken  String   @map("sell_token") // the chain's primary stable at creation (USDC / USDG)
  chainId    Int      @map("chain_id")
  /// Our own harness/drill schedule (lib/internal-run.ts): the first "DCA …
  /// weekly" turn WRITES a schedule (+ its period job); the GTM arc reads
  /// dca_schedules as an arrival, so a gate run must never count. Jobs the
  /// schedule mints inherit the flag.
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  /// Autonomous tier (Spend Permissions). 'confirm' = the user signs every
  /// buy (the default, works for any wallet). 'auto' = the user's SMART
  /// wallet signed ONE SpendPermission whose allowance == buyUsd per cadence
  /// period — the on-chain SpendPermissionManager caps the pull regardless
  /// of this codebase, and the sweep executes each due period's buy with the
  /// swap output pinned to the OWNER's wallet. Disarm never deletes the
  /// schedule — it drops back to confirm-mode.
  mode               String    @default("confirm") // confirm | auto
  permissionJson     String?   @map("permission_json") // SpendPermission struct, bigints as strings
  permissionSig      String?   @map("permission_sig") // the user's one-time EIP-712 signature
  permissionHash     String?   @map("permission_hash") // manager.getHash(permission) — read from the CONTRACT, never computed locally
  permissionApproved Boolean   @default(false) @map("permission_approved") // approveWithSignature landed on-chain
  spender            String? // the CDP-managed spender bound at arm time (lowercased)
  armNetwork         String?   @map("arm_network") // base | base-sepolia
  armedAt            DateTime? @map("armed_at")
  autoError          String?   @map("auto_error") // last sweep failure — the ONLY thing that badges needs-you

  runs     DcaRun[]
  autoRuns DcaAutoRun[]

  @@index([wallet, createdAt])
  @@index([status])
  @@map("dca_schedules")
}

/// One period's buy attempt. The @@unique([scheduleId, periodKey]) row IS the
/// idempotency claim — overlapping taps/turns can't double-offer a period.
/// Status is DERIVED from the linked one-step job (done → bought, failed /
/// canceled → the period is reclaimable), never stored separately.
model DcaRun {
  id         String   @id @default(cuid())
  scheduleId String   @map("schedule_id")
  wallet     String
  periodKey  String   @map("period_key") // 2026-07-16 | 2026-W29 | 2026-07 (UTC)
  jobId      String?  @map("job_id") // the one-step buy job this period's claim produced
  createdAt  DateTime @default(now()) @map("created_at")

  schedule DcaSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, periodKey])
  @@index([wallet, createdAt])
  @@map("dca_runs")
}

/// One AUTONOMOUS period's buy — the receipt row (guardian-runs pattern:
/// standing value lives in its own table, never embed_turns). The
/// @@unique([scheduleId, periodKey]) row is the sweep's idempotency claim —
/// created BEFORE any tx is sent, so overlapping crons can't double-pull.
/// A failed run keeps the claim (no retry-until-it-spends): the error
/// surfaces as the schedule's auto_error and the NEXT period tries fresh.
model DcaAutoRun {
  id         String   @id @default(cuid())
  scheduleId String   @map("schedule_id")
  wallet     String // lowercased schedule owner (the swap's pinned recipient)
  periodKey  String   @map("period_key") // same UTC calendar keys as dca_runs
  status     String   @default("running") // running | bought | failed
  valueUsd   Float?   @map("value_usd") // the pulled USDC, guardrail-priced
  spendTx    String?  @map("spend_tx") // SpendPermissionManager.spend hash
  swapTx     String?  @map("swap_tx") // the venue swap hash (output → owner)
  detail     String? // human receipt line / failure reason
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  schedule DcaSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, periodKey])
  @@index([wallet, createdAt])
  @@map("dca_auto_runs")
}

/// A public receipt permalink (/r/<id>) minted from something the owner
/// signed or armed: a settled tx turn, a done job, a DCA schedule, a
/// guardian protection. The row is a SNAPSHOT taken at share time — the
/// public page never queries the live artifact, so nothing about the
/// owner's ongoing activity leaks after the click. `via` is the sharer's
/// stable short id (a hash of the wallet, never the wallet itself) that
/// rides every outbound link for arrival attribution.
model ShareReceipt {
  id       String  @id @default(cuid()) // unguessable slug — /r/<id>
  kind     String // 'tx' | 'job' | 'dca' | 'guardian'
  wallet   String // lowercased owner (SIWE-verified at creation)
  via      String // sharer short id — viaIdOf(wallet)
  refId    String? @map("ref_id") // jobId / scheduleId / policyId / messageId
  headline String // "$10 → AAPL · every week"
  ask      String? // the do-this-yourself prompt the CTA prefills
  standing Boolean @default(false) // ran between turns — nobody at the keyboard
  valueUsd Float?  @map("value_usd")
  facts    Json    @default("[]") // [{ label, value }] public-safe lines
  txs      Json    @default("[]") // [{ hash, chainId, title }]
  revoked  Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([wallet, createdAt])
  @@map("share_receipts")
}

/// First-touch share attribution: the wallet's FIRST sign-in that carried a
/// `yf_via` cookie (set client-side from any ?via= landing). One row per
/// wallet, insert-only, first writer wins — so the cohort view can answer
/// "did this wallet arrive via a share link?" without tracking anything else.
model WalletArrival {
  address   String   @id // lowercased
  via       String // the sharer's short id from the link
  landing   String? // pathname the via param was first seen on
  createdAt DateTime @default(now()) @map("created_at")

  @@map("wallet_arrivals")
}

/// An intent link — a short URL carrying an ASK (a sentence, never calldata).
/// /i/<id> shows the ask + the guardrail contract; "Connect & build" is the
/// consent that runs the scan+build through the chat machinery. Minted
/// self-serve by a SIWE-verified creator; redirectUrl is validated https at
/// MINT time and stored here (never read from the runtime query string), and
/// renders post-receipt as an explicit "Return to <host>" button.
model IntentLink {
  id           String    @id // short slug — /i/<id>
  ask          String // the sentence (sanitized at mint)
  variants     String[]  @default([]) // A/B alternate phrasings (≤3); index 0 = ask
  mcps         String? // comma-separated slugs auto-composed from the intent
  creator      String? // lowercased wallet (SIWE-verified at mint)
  agent        String? // optional byline shown on the runtime page
  redirectUrl  String?   @map("redirect_url")
  // Partner-promo limits (all optional): a link can expire, cap its total
  // SERVER-TRUTH signs (embed_turns, never client events), and reserve
  // itself for an allowlist of wallets (targeting, not a security boundary
  // — the ask itself is public on the page).
  expiresAt    DateTime? @map("expires_at")
  maxSigns     Int?      @map("max_signs")
  allowWallets String[]  @default([]) @map("allow_wallets")
  revoked      Boolean   @default(false)
  // MOSAIC lineage: kind stamps executable-allocation links ('mosaic') so
  // the gallery and the tessera OG card can find them without re-parsing
  // every ask; parentSlug records fork provenance (one tap "fork this
  // shape" → a new link that credits its ancestor on the page).
  kind         String?
  parentSlug   String?   @map("parent_slug")
  // The wallet inbox (M5): when an intent is ADDRESSED to someone, recipient
  // is their lowercased wallet and senderLabel names who sent it. Addressed
  // links appear in that wallet's /inbox; allowWallets is set to [recipient]
  // so the /i CTA targets them (the signature is still the real gate).
  recipient    String? // lowercased wallet an intent is addressed TO
  senderLabel  String?   @map("sender_label")
  // THE ROSTER (R2): a proposal from a HIRED agent binds to its mandate
  // slot — the /i header + inbox card wear the slot badge, and firing the
  // slot cascades revocation over its unsigned addressed links (T5).
  rosterSlotId String?   @map("roster_slot_id")
  // Our own harness/drill mint (lib/internal-run.ts): every test:api run
  // mints links from throwaway wallets, which inflated the GTM arc's
  // "arrived" denominator by hundreds per gate run (2026-08-17 audit). The
  // arc + digest exclude stamped rows; the link itself still works.
  isInternal   Boolean   @default(false) @map("is_internal")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([creator, createdAt])
  @@index([kind, createdAt])
  @@index([recipient, createdAt])
  @@index([isInternal, createdAt])
  @@index([rosterSlotId])
  @@map("intent_links")
}

/// An opt-in public page name for a link creator — /l/<handle> lists their
/// active links (the storefront). Opt-in by claiming keeps the leaderboard's
/// privacy rule intact: no wallet is ever the key to a public page.
model CreatorHandle {
  handle         String    @id // lowercase slug — /l/<handle>
  creator        String    @unique // lowercased wallet (SIWE-verified at claim)
  createdAt      DateTime  @default(now()) @map("created_at")
  // White-label brand, scanned from the creator's own site URL (one paste,
  // no form): logo stored as a size-capped data URI so the page never
  // hotlinks or re-fetches a foreign host at render time.
  brandDomain    String?   @map("brand_domain")
  brandName      String?   @map("brand_name")
  brandLogo      String?   @map("brand_logo")
  brandAccent    String?   @map("brand_accent")
  brandBg        String?   @map("brand_bg")
  brandUpdatedAt DateTime? @map("brand_updated_at")

  @@map("creator_handles")
}

/// The per-link funnel, event-sourced: open → connect → built → signed.
/// Best-effort client posts; aggregated for the creator dashboard.
model IntentLinkEvent {
  id        String   @id @default(cuid())
  slug      String
  kind      String // 'open' | 'connect' | 'built' | 'signed'
  variant   Int? // which phrasing this visit saw (0 = the base ask)
  wallet    String? // lowercased, when known (connect and later)
  valueUsd  Float?   @map("value_usd") // guardrail-priced, signed/built turns
  /// On-chain receipt verification (security 2026-09-01). NULL = legacy
  /// (pre-feature — keeps counting). New signed/settled rows carry:
  ///   'verified'   — receipt read on-chain, from == wallet, hash single-use,
  ///                  to+selector matched the link's own built artifact
  ///   'attested'   — non-EVM-tx class (order/hl/vote/nft/job), server-derived
  ///                  from the link's ask; venue reads are the next tranche
  ///   'unverified' — hashless, RPC down, or receipt not yet indexed;
  ///                  COUNTS NOTHING, FIRES NOTHING; lazily re-checked ≤7d
  ///   'mismatch'   — spoof (wrong from, reverted, reused hash, wrong
  ///                  target); terminal, never counts
  txHash       String?   @map("tx_hash")
  chainId      Int?      @map("chain_id")
  verification String?
  verifiedAt   DateTime? @map("verified_at")
  /// Our own harness/drill event (lib/internal-run.ts): wallet-bearing
  /// events read as GTM-arc arrivals — a gate run must never count.
  isInternal   Boolean   @default(false) @map("is_internal")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([slug, kind])
  @@map("intent_link_events")
}

/// The link's own built-artifact expectations (security 2026-09-01): the
/// chat route's response choke records {to, selector, chainId} for every
/// tx/txChain built on an /i turn, keyed by (slug, wallet). Receipt
/// verification binds a claimed tx hash to THESE — a real tx pointed at
/// any other target is a mismatch. Rows are hygiene-pruned after 7d.
model IntentLinkExpectation {
  id        String   @id @default(cuid())
  slug      String
  wallet    String // lowercased signer the artifact was built for
  chainId   Int      @map("chain_id")
  toAddr    String   @map("to_addr") // lowercased tx.to
  selector  String? // first 4 bytes of calldata ('0x…8 hex'); null = native send
  createdAt DateTime @default(now()) @map("created_at")

  @@index([slug, wallet])
  @@map("intent_link_expectations")
}

/// A creator payout request against accrued intent-link earnings (half of
/// the swap fee on link-attributed signed conversions, computed read-time
/// from embed_turns). Manual payout in v1: Nate settles, sets status paid +
/// txUrl. Phase 2 replaces accrual with per-creator on-chain splits.
model IntentLinkClaim {
  id        String   @id @default(cuid())
  creator   String // lowercased wallet
  amountUsd Float    @map("amount_usd")
  status    String   @default("requested") // requested | paid | rejected
  txUrl     String?  @map("tx_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([creator, createdAt])
  @@map("intent_link_claims")
}

/// Spot Guardian (the HL Guardian's promise on SPOT holdings, via the DCA
/// autopilot's Spend Permission rails): ONE one-shot permission over the
/// protected asset; when the trigger fires the sweep sells it to USDC with
/// the output pinned to the OWNER. Non-custodial end to end.
model SpotGuardPolicy {
  id        String @id @default(cuid())
  wallet    String // lowercased owner
  /// awaiting_signature → active → triggered → done; paused | error on the side.
  status    String @default("awaiting_signature")
  originEnv String @default("dev") @map("origin_env")
  chainId   Int    @map("chain_id") // Base-only v1 (the autopilot chain)

  tokenSymbol  String  @map("token_symbol") // ETH, WETH, CBETH…
  tokenAddress String  @map("token_address") // ERC-20 addr, or the ERC-7528 native sentinel
  native       Boolean @default(false)
  amountAtoms  String  @map("amount_atoms") // bigint as string — the permission allowance
  amountHuman  String  @map("amount_human") // display

  triggerMode  String @map("trigger_mode") // price | price_move_pct
  triggerValue Float  @map("trigger_value")
  refPrice     Float  @map("ref_price") // arm-time venue mark (USD) — the pct anchor

  permissionJson     String?   @map("permission_json") // SpendPermission struct, bigints as strings
  permissionSig      String?   @map("permission_sig")
  permissionHash     String?   @map("permission_hash") // manager.getHash — from the CONTRACT
  permissionApproved Boolean   @default(false) @map("permission_approved")
  spender            String? // the CDP spender bound at arm time (lowercased)
  armNetwork         String?   @map("arm_network")
  armedAt            DateTime? @map("armed_at")

  lastChecked DateTime? @map("last_checked") // sweep heartbeat
  lastMark    Float?    @map("last_mark")
  error       String? // last sweep failure — the ONLY thing that badges needs-you

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  runs SpotGuardRun[]

  @@index([wallet, status])
  @@index([status, chainId])
  @@map("spot_guard_policies")
}

model SpotGuardRun {
  id        String   @id @default(cuid())
  policyId  String   @map("policy_id")
  wallet    String // lowercased policy owner (the sell's pinned recipient)
  status    String   @default("running") // running | sold | failed
  valueUsd  Float?   @map("value_usd") // mark-priced protected value at fire time
  markPrice Float?   @map("mark_price")
  spendTx   String?  @map("spend_tx") // SpendPermissionManager.spend hash
  swapTx    String?  @map("swap_tx") // the venue sell hash (USDC → owner)
  detail    String? // human receipt line / failure reason
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  policy SpotGuardPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId]) // one-shot: a policy fires at most once
  @@index([wallet, createdAt])
  @@map("spot_guard_runs")
}

// A brokered intent from the agent desk (/api/broker MCP): an external
// agent's ask, its negotiation plan, and the sign link it was handed off
// to. States move rightward only: open → handed_off → signed → settled,
// or → closed. plan is the serialized BrokerPlan (sentences only — the
// leak check upstream guarantees no transaction material lands here).
model BrokerIntent {
  id             String   @id // mintSlug(10)
  ask            String // the current working sentence
  wallet         String? // lowercased 0x… the agent negotiated for, if any
  agent          String? // sanitized self-reported agent name
  agentKey       String?  @map("agent_key") // the bound desk identity (execute path); M6 makes it x402-payer-verified
  agentKeyHash   String?  @map("agent_key_hash") // sha256(agentKey)[:16] — the PUBLIC track-record handle (raw key never exposed)
  /// Our own harness/drill intent (lib/internal-run.ts): the public /agents
  /// record excludes it — a gate run must never headline the credit bureau.
  isInternal     Boolean  @default(false) @map("is_internal")
  callbackUrl    String?  @map("callback_url") // optional agent webhook: signed/settled events POST here (M3)
  callbackSecret String?  @map("callback_secret") // per-intent HMAC secret returned to the agent once at open
  state          String   @default("open")
  plan           Json
  linkSlug       String?  @map("link_slug") // bound /i/<slug> after handoff
  jobId          String?  @map("job_id") // bound job after broker_execute (agent-signed path)
  /// THE ROSTER (R2): set when the presented agent_key hashed to a hired
  /// mandate slot — the proposal auto-addressed to the employer's inbox and
  /// the build gate re-checks this slot (fired-agent race, T5).
  rosterSlotId   String?  @map("roster_slot_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([state, createdAt])
  @@index([agentKeyHash])
  @@index([isInternal])
  @@index([rosterSlotId])
  @@map("broker_intents")
}

// THE ROSTER (R1) — a wallet's mandate slots: job listings for AI agents.
// A slot is a CANONICAL SENTENCE (parseMandate-proven to round-trip its
// executor's grammar — threat T2: raw input is parsed then dropped), a
// per-proposal dollar cap, and — once hired via personal_sign consent —
// the agent's public track-record handle (agentHandleFor shape). States
// move one way: pending → hired → benched ⇄ hired → fired (terminal;
// re-hire = a new row). Drafts ('pending') are INERT: they publish
// nowhere, address nothing, and self-clean after 24h unhired. The wallet
// keeps the only pen: a slot never holds funds or keys.
model RosterSlot {
  id               String    @id // mintSlug(10)
  walletAddress    String    @map("wallet_address") // lowercased employer wallet
  mandateText      String    @map("mandate_text") // CANONICAL mandate sentence — re-parses with the executor's own grammar
  mandateKind      String    @map("mandate_kind") // shape | dca | protect | yield
  agentKeyHash     String?   @map("agent_key_hash") // agent's PUBLIC handle (sha256(agent_key)[:16]); set at hire-consent mint, active only once status='hired'
  capUsd           Float     @default(200) @map("cap_usd") // per-proposal ceiling the hire consent named
  status           String    @default("pending") // pending | hired | benched | fired
  /// Single-use consent nonce + expiry + which action it was minted for
  /// (hire|fire). Cleared on success; never serialized to any GET.
  consentNonce     String?   @map("consent_nonce")
  consentAction    String?   @map("consent_action")
  consentExpiresAt DateTime? @map("consent_expires_at")
  /// WAVE-2 discovery: opt-in public job listing. `listed` flips true only
  /// via the owner's signed 'list' consent (which also exempts the draft
  /// from the 24h purge — a listed slot is owner-PROVEN, not a squattable
  /// draft). `listToken` is the feed's public handle — the wallet NEVER
  /// rides the feed (T-D1); the token resolves server-side at broker_open
  /// and dies on unlist/hire/delete.
  listed           Boolean   @default(false)
  listToken        String?   @unique @map("list_token")
  /// Our own harness/drill slot (lib/internal-run.ts): no scoreboard, league,
  /// or track record may ever count it.
  isInternal       Boolean   @default(false) @map("is_internal")
  /// Lifetime cap-breach count for THIS slot (benchSlot increments — status
  /// 'benched' is current-state only and can flip back to hired, so the
  /// standings' "cap breaches (0 is the badge)" tile needs the counter,
  /// ROSTER-TRYOUTS-SPEC §2.3/2.4).
  capBreaches      Int       @default(0) @map("cap_breaches")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([walletAddress, status])
  @@map("roster_slots")
}

/// The Founding Manager badge (FOUNDING-MANAGERS.md §1): a permanent,
/// COSMETIC + HISTORICAL mark on an agent's public record — never a rank,
/// never an endorsement. Rows are owner-set only (scripts/set-founding-agent
/// .ts); nothing in the product writes here.
model FoundingAgent {
  /// The agent's PUBLIC handle — sha256(agent_key)[:16], agentHandleFor's shape.
  agentKeyHash String   @id @map("agent_key_hash")
  /// Optional owner note (e.g. cohort number). Never rendered publicly.
  label        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("founding_agents")
}

// M6 forward-paper tryouts (ROSTER-TRYOUTS-SPEC §1). PAPER IS STRUCTURAL:
// these two tables are the ONLY place a tryout exists — never intent_links,
// never broker_intents, never inbox items, never embed_turns; record and
// standings queries never join them. A mark stores quote NUMBERS from the
// executor's own read-only quote path — never calldata. Append-only: no
// delete API exists ('retired' keeps the row — survivorship rule §1.5-3).
model RosterTryout {
  id           String    @id // mintSlug(10)
  wallet       String // owner wallet (connect-to-act reads, rule 6)
  agentKeyHash String    @map("agent_key_hash") // M4 identity hash — never the raw key
  mandateText  String    @map("mandate_text") // CANONICAL recompose from parseMandate (T2)
  mandateKind  String    @map("mandate_kind")
  mandateHash  String    @map("mandate_hash") // sha256(canonical)[:16]
  capUsd       Float     @default(200) @map("cap_usd") // caps paper marks with the real gate's copy
  status       String    @default("running") // running | reviewed | retired — append-only
  startedAt    DateTime  @default(now()) @map("started_at")
  /// FIXED AT CREATION = started_at + 7 days. IMMUTABLE — no update path
  /// exists anywhere (cherry-picked review time, §1.5-2).
  reviewAt     DateTime  @map("review_at")
  reviewedAt   DateTime? @map("reviewed_at") // actual capture moment — shown on the card
  isInternal   Boolean   @default(false) @map("is_internal")
  createdAt    DateTime  @default(now()) @map("created_at")

  marks RosterTryoutMark[]

  @@index([agentKeyHash, mandateKind, status])
  @@index([wallet, createdAt])
  @@map("roster_tryouts")
}

model RosterTryoutMark {
  id             String   @id // mintSlug(10)
  tryoutId       String   @map("tryout_id")
  seq            Int
  proposedAt     DateTime @default(now()) @map("proposed_at")
  askText        String   @map("ask_text") // canonical proposal sentence — grammar round-trip required
  venue          String // the executor quote path's venue label
  routeRef       String   @map("route_ref") // pool/route the quote came from (auditability, §1.5-5)
  quoteAtPropose Json     @map("quote_at_propose") // {pair, side, amountIn, quoteOut, unit} — SERVER-computed (§1.5-1)
  quoteAtReview  Json?    @map("quote_at_review") // same shape, same fn, WRITE-ONCE at review
  periodKey      String?  @map("period_key") // cadence dedupe — dca per period, others per UTC day (§1.5-4)
  isInternal     Boolean  @default(false) @map("is_internal")

  tryout RosterTryout @relation(fields: [tryoutId], references: [id], onDelete: Cascade)

  @@unique([tryoutId, periodKey])
  @@map("roster_tryout_marks")
}
