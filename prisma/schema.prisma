// Yeetful — x402 MCP directory.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector] // pgvector — semantic routing (R2)
}

/// A featured x402 agent/MCP. Ingested from agentic.market (see
/// scripts/ingest-agentic.ts) and enriched for the verified, callable ones.
model McpServer {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String

  category String // Inference | Data | Search | Media | Social | Trading | Infra | Storage | Travel | Other
  kind     String // 'inference' | 'data' — drives chat orchestration

  // Pricing + chains (from agentic.market)
  priceUsd String?  @map("price_usd") // min price per call, e.g. "0.001"
  networks String[] // e.g. ["Base","Solana"] or ["eip155:8453"]

  // false = FREE (non-x402) MCP — no payment gate at the endpoint, calls skip
  // the 402 handshake entirely (still policy-gated + traced + ledgered at $0).
  gated Boolean @default(true)

  // x402 call wiring — only set for callable (verified) services
  callable   Boolean @default(false)
  endpoint   String?
  protocol   String? // 'mcp' | 'http'
  tool       String? // MCP tool name (inference) or wired data tool (mcp data)
  queryParam String? @map("query_param") // primary query param (http data)
  // Default JSON arguments for the wired MCP data `tool`, e.g. {"chains":["ethereum","base"]}.
  // Used by the chat orchestrator to call an MCP *data* service's tool (which
  // takes structured args, not a free-text prompt). Null for inference/http.
  toolArgs   Json?   @map("tool_args")

  // The x402 `payTo` receiver read from this server's wired `endpoint` (lowercased).
  // Whoever controls this wallet operates the server and collects its revenue, so
  // it's the address that can self-claim ownership (see lib/mcp-claim.ts). Backfilled
  // from the live 402 challenge by `npm run db:receivers`; null = unread/unreachable.
  receiver          String?   @map("receiver")
  receiverCheckedAt DateTime? @map("receiver_checked_at")

  // Launchpad (x402-launch): the MCP's token + YeetfulStaking vault, set once a
  // token is launched on the bonding curve. Null = not launched yet. The on-chain
  // YeetfulLaunchFactory is the source of truth; these mirror it for fast reads
  // (fee routing + the per-service token chart). See repo `x402-launch`.
  tokenAddress   String? @map("token_address")
  stakingAddress String? @map("staking_address")

  // Presentation
  iconSlug   String? @map("icon_slug") // Simple Icons brand slug for the glyph
  color      String?
  websiteUrl String? @map("website_url") // agentic.market service page

  // Capability metadata (R1) — LLM-labeled at ingest (scripts/tag-capabilities.ts)
  // so routing matches on MEANING, not just keyword overlap. `tags` = controlled
  // domain vocab (sports, web-search, transcription…); `exampleQueries` = a few
  // user phrasings this MCP answers. Both folded into the shortlist haystack.
  tags           String[] @default([])
  exampleQueries String[] @default([]) @map("example_queries")

  // Routability report (RR14) — the mcp:lint grader's latest result: overall
  // score, per-dimension breakdown, and the concrete fix list. Written by
  // `npm run mcp:lint -- <slug> --save`; the server page's routability panel
  // reads it. Null = never linted.
  routability Json? @map("routability")

  // Provenance
  source     String   @default("agentic.market")
  featured   Boolean  @default(true)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // The full x402 endpoint surface (one service → many endpoints). The flat
  // endpoint/protocol/tool/queryParam above is the single *wired* call used by
  // the chat orchestrator for callable services; this is the browsable catalog.
  endpoints McpEndpoint[]
  approvals AgentApproval[]

  @@index([category])
  @@index([callable])
  @@map("mcp_servers")
}

/// One callable x402 endpoint of a service (e.g. Claude's POST /v1/messages via
/// Bankr). Descriptive catalog data for the service detail page — services stay
/// the unit of selection in chat; endpoints are never individually selectable.
model McpEndpoint {
  id          String  @id @default(cuid())
  serverId    String  @map("server_id")
  method      String // GET | POST | …
  url         String
  description String?

  // Pricing (USDC). For 'upto' schemes priceUsd is the min and maxPriceUsd the
  // ceiling (e.g. $0.001 – $10.00); for 'exact', priceUsd is the flat amount.
  priceUsd    String? @map("price_usd")
  maxPriceUsd String? @map("max_price_usd")
  scheme      String? // 'exact' | 'upto'
  network     String?
  provider    String? // gateway that serves it (providerName: Venice, Bankr, …)
  position    Int     @default(0) // display order within the service

  /// Structured parameter schemas from agentic.market, when published:
  /// [{ group: 'query'|'path'|'body', name, type, description, example,
  ///    required, enumValues, default }]. Drives the chat planner — an
  /// endpoint with params is auto-callable; without, it's display-only.
  parameters Json?

  /// Provenance of `parameters`: null = from agentic.market ingest, 'inferred' =
  /// LLM-recovered by scripts/infer-params.ts for endpoints agentic.market ships
  /// no schema for. Reversible: set parameters=NULL where params_source='inferred'.
  paramsSource String? @map("params_source")

  /// Owner/admin-flagged "start here" endpoint. Two consumers: the connect-time
  /// quick view pings featured endpoints first for a newly connected wallet
  /// (the generic splash tile for MCPs with no hand-coded source), and the
  /// endpoint planner floats them to the front of its menu as starting hints
  /// when an ask is broad. Set from the add-MCP modal (featuredTools) or the
  /// admin star on /servers/[slug]. Column applied via raw SQL — never
  /// `db push` (drifted harness_results table would be dropped).
  featured Boolean @default(false)

  /// Semantic embedding (R2) of "service + tags + examples + description + path",
  /// from OpenAI text-embedding-3-small (1536-dim). Populated by
  /// scripts/embed-catalog.ts; queried via raw SQL (pgvector `<=>` cosine) in
  /// lib/retrieval.ts. Unsupported in the Prisma client — read/written via $raw.
  embedding Unsupported("vector(1536)")?

  server    McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([serverId, method, url])
  @@index([serverId])
  @@map("mcp_endpoints")
}

/// Free-probe liveness results (scripts/harness-probe.ts writes, lib/health.ts
/// reads — both via RAW SQL; the table historically self-bootstrapped outside
/// this schema, which made `prisma db push` propose DROPPING it (caught
/// 2026-07-06, 1865 rows). Declared here so push sees it as in-sync; keep the
/// column shapes matching the bootstrap DDL in harness-probe.ts exactly.
model HarnessResult {
  id          String   @id
  endpointId  String   @map("endpoint_id")
  service     String?
  method      String?
  url         String?
  httpStatus  Int?     @map("http_status")
  status      String
  priceUsd    Float?   @map("price_usd")
  scheme      String?
  network     String?
  payTo       String?  @map("pay_to")
  x402Version Int?     @map("x402_version")
  errorReason String?  @map("error_reason")
  latencyMs   Int?     @map("latency_ms")
  probedAt    DateTime @default(now()) @map("probed_at") @db.Timestamp(6)

  @@index([endpointId])
  @@index([status])
  @@map("harness_results")
}

/// A user's rating of an MCP service — the human signal in the reputation score
/// (alongside the automated reliability/liveness/speed/adoption/value metrics).
/// One rating per wallet per service (upsert to change). Keyed by service SLUG
/// so it survives a service rename. Bayesian-averaged in lib/reputation so a
/// single vote can't swing a score.
model McpRating {
  id           String   @id @default(cuid())
  serviceSlug  String   @map("service_slug")
  ownerAddress String   @map("owner_address") // SIWE wallet that rated
  rating       Int // 1–5 stars
  review       String? // optional short note
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([serviceSlug, ownerAddress])
  @@index([serviceSlug])
  @@map("mcp_ratings")
}

/// Who owns/operates an MCP, for the launchpad (repo x402-launch). The claimant
/// proves control of the MCP's backing GitHub repo by committing
/// `.well-known/yeetful-claim.txt` containing their wallet address, and proves
/// the wallet via SIWE. One owner per MCP. This owner is the creator-of-record
/// for the MCP's token (the on-chain creator/treasury) and, once a token
/// launches, the recipient of the creator fee split. Until claimed, that cut
/// escrows on-chain (YeetfulStaking.treasury).
model McpOwner {
  id           String   @id @default(cuid())
  mcpSlug      String   @unique @map("mcp_slug") // the claimed McpServer.slug
  ownerAddress String   @map("owner_address") // lowercased, SIWE-verified
  /// How ownership was proven. 'receiver' = signed in with the wallet the MCP's
  /// x402 `payTo` is set to (read from its own 402 challenge — proves control of
  /// the account that collects the MCP's revenue). 'admin' = a Yeetful admin
  /// verified it (endpoint unreadable / shared-gateway payee / Yeetful's own).
  verifiedVia  String   @default("receiver") @map("verified_via")
  /// The endpoint host ownership was checked against (e.g. anthropic.yeetful.com).
  verifiedHost String?  @map("verified_host")
  repo         String?  // optional: link to the MCP's source repo (display only, NOT the proof)
  githubLogin  String?  @map("github_login")
  claimedAt    DateTime @default(now()) @map("claimed_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([ownerAddress])
  @@map("mcp_owners")
}

/// Earn-side ledger: one row per paid call an MCP *served* (the payee side of the
/// control plane, mirroring SpendLedgerEntry on the payer side). Reported by the
/// MCP itself via POST /api/mcp/receipts (Bearer key → must own the slug), so it's
/// self-reported telemetry for rich/real-time analytics — on-chain receiver
/// activity is the trust layer. ownerAddress is denormalized (lowercased) so
/// earnings are queryable per wallet and survive a re-claim.
model McpReceipt {
  id           String   @id @default(cuid())
  mcpSlug      String   @map("mcp_slug") // the McpServer.slug that served the call
  ownerAddress String   @map("owner_address") // payee wallet at report time (lowercased)
  payer        String?  // the paying agent's wallet (lowercased), if the MCP reports it
  amountUsd    Float    @map("amount_usd")
  tool         String?  // MCP tool / resource the call hit (display)
  network      String?  // e.g. "base"
  txHash       String?  @unique @map("tx_hash") // unique ⇒ a settlement tx is counted once
  apiKeyId     String?  @map("api_key_id") // which key reported it
  /// On-chain verification (the trust layer). null = not checked / no txHash to
  /// check; true = a USDC transfer to the MCP's payTo backing ≥ the claimed
  /// amount was found on-chain; false = a txHash was given but contradicts the
  /// claim (a red flag — self-report not backed by settlement).
  verified     Boolean?  @map("verified")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([mcpSlug, createdAt])
  @@index([ownerAddress, createdAt])
  @@map("mcp_receipts")
}

/// A chat owned by a wallet address (verified via SIWE — see lib/auth.ts).
/// Private by default; the owner can opt in to a public, unlisted share link
/// (publicSlug). The sharing UI lands in a later branch — the schema is ready.
model Chat {
  id           String  @id @default(cuid())
  title        String  @default("New chat")
  ownerAddress String  @map("owner_address") // lowercased, SIWE-verified

  // Selected x402 agents for this chat (slugs/ids), so a reopened chat
  // restores its active set.
  activeServerIds String[] @map("active_server_ids")

  // Opt-in public sharing. isPublic flips it on; publicSlug is the unguessable
  // id used in the share URL (/p/<publicSlug>); publicAt is when it was shared.
  isPublic   Boolean   @default(false) @map("is_public")
  publicSlug String?   @unique @map("public_slug")
  publicAt   DateTime? @map("public_at")

  messages  Message[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([ownerAddress])
  @@map("chats")
}

model Message {
  id      String  @id @default(cuid())
  chatId  String  @map("chat_id")
  role    String // 'user' | 'assistant'
  content String
  /// optional per-turn metadata (e.g. x402 payment receipts)
  meta    Json?

  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([chatId])
  @@map("messages")
}

/// A company workspace: shared agents, keys, budgets, and ledger under one
/// roof. Membership is wallet-native — adding an address IS the invite (it
/// takes effect on the invitee's next SIWE sign-in; no email machinery).
/// Org-scoped rows on the spending tables carry org_id; NULL = personal
/// scope, so every pre-org row keeps working unchanged.
model Organization {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  createdBy String @map("created_by") // lowercased wallet of the founder

  /// Org-level daily cap (USD) across ALL the org's agent keys — the level
  /// above per-key budgets. Null = no org cap. Advisory at the rails
  /// (SDK-enforced via /api/agent/policy) until Coinbase Spend Permissions.
  perDayUsd Float? @map("per_day_usd")

  members   OrgMember[]
  apiKeys   ApiKey[]
  grants    SpendGrant[]
  approvals AgentApproval[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

/// One wallet's membership in an org. Roles: owner > admin > member —
/// the matrix lives in lib/org.ts (requireRole), enforced server-side in
/// every org route; a Bearer key can NEVER manage membership (SIWE only).
model OrgMember {
  id      String  @id @default(cuid())
  orgId   String  @map("org_id")
  address String // lowercased wallet
  role    String  @default("member") // owner | admin | member
  addedBy String? @map("added_by") // lowercased wallet that sent the invite

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([orgId, address])
  @@index([address])
  @@map("org_members")
}

/// An "agent expense account": a scoped, wallet-owned authorization to pay x402
/// endpoints up to a budget. It's POLICY, not custody — Yeetful enforces the
/// caps + allowlist and ledgers every decision; the funds move from the payer
/// (today the house burner; later a Coinbase Spend Permission / session key
/// scoped to this grant) straight to the seller. See lib/spend-grant.ts.
model SpendGrant {
  id           String @id @default(cuid())
  ownerAddress String @map("owner_address") // lowercased, SIWE-verified
  /// Org scope; NULL = the owner's personal expense account (pre-org rows
  /// all have NULL — back-compat by construction).
  orgId        String? @map("org_id")
  label        String @default("Agent expense account")

  /// Exact hostnames this grant may pay (e.g. "tripadvisor.x402.paysponge.com").
  allow String[]

  /// Caps in USD. perDay resets at local midnight (UTC); total is a lifetime cap.
  perCallUsd Float  @map("per_call_usd")
  perDayUsd  Float  @map("per_day_usd")
  totalUsd   Float? @map("total_usd")

  expiresAt DateTime @map("expires_at")
  status    String   @default("active") // active | revoked | expired
  /// Kill switch: a reversible freeze of the whole expense account (distinct
  /// from status:revoked, which is permanent and drops the grant from
  /// getActiveGrant). When true, every chat path Yeetful executes HARD-refuses
  /// with ACCOUNT_FROZEN and /api/agent/policy reports halted; the SDK refuses
  /// too. Toggled SIWE-only (owner / org admin).
  paused    Boolean  @default(false) @map("paused")

  /// Master power switch for the spend policy. Default OFF so a new user's
  /// first run is unrestricted (the policy is otherwise a big trial blocker).
  /// When false, checkGrant() short-circuits — no allowlist, no caps, any host.
  /// Independent of `paused` and of the per-agent approval rows (flipping this
  /// never mutates agent_approvals, so a curated allowlist survives a toggle).
  /// Existing grants are backfilled to true to preserve current behavior.
  spendPolicyEnabled Boolean @default(false) @map("spend_policy_enabled")

  /// EIP-712 signature of the grant terms. Null while grants are SIWE-session
  /// gated; populated once wallet-signed approvals are wired (then this is the
  /// portable authorization artifact / precursor to an on-chain Spend Permission).
  signature String?

  /// Coinbase Spend Permission backing this grant on-chain — the hard stop the
  /// advisory pause/budget points at. Null = SDK-advisory only. When set, the
  /// grant's per-day cap is mirrored by an on-chain SpendPermission (allowance
  /// over a 1-day period) on a CDP Smart Account, so the wallet contract caps
  /// spend regardless of the SDK. `Id` = the CDP permission id / userOp hash;
  /// `Network` = 'base' | 'base-sepolia'. Drives the "Backed on-chain" badge.
  spendPermissionId      String? @map("spend_permission_id")
  spendPermissionNetwork String? @map("spend_permission_network")

  org       Organization?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ledger    SpendLedgerEntry[]
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([ownerAddress])
  @@index([orgId])
  @@index([status])
  @@map("spend_grants")
}

/// Append-only record of every authorization decision under a grant — the audit
/// trail, the budget data, and the x402 payment receipts in one table.
model SpendLedgerEntry {
  id        String  @id @default(cuid())
  grantId   String  @map("grant_id")
  host      String
  /// Directory service the call belonged to (e.g. "Yeetful · Claude") — lets
  /// the dashboard chart per-agent without reverse-mapping hosts.
  serviceName String? @map("service_name")
  amountUsd Float   @map("amount_usd")
  ok        Boolean
  txHash    String? @map("tx_hash")
  note      String? // "settled" | "dry-run" | a GrantViolation code
  /// Round-trip latency of the paid call in ms (settle time), when measured —
  /// feeds the per-MCP "speed" reputation sub-score. Null on older rows / blocks.
  latencyMs Int?    @map("latency_ms")
  /// Which connected agent (API key) synced this receipt — set when the entry
  /// arrives via Bearer auth, so spend is attributable per agent.
  apiKeyId  String? @map("api_key_id")
  /// Denormalized org attribution (no FK — audit rows must outlive nothing;
  /// the grant relation already cascades them). NULL = personal spend.
  orgId     String? @map("org_id")

  grant     SpendGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  apiKey    ApiKey?    @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([grantId])
  @@index([grantId, ok, createdAt])
  // Per-agent spent-today (the Agents tab + /api/agent/policy).
  @@index([apiKeyId, ok, createdAt])
  // Org spent-today (the two-level budget + the expense report).
  @@index([orgId, ok, createdAt])
  // Global public feed (/api/activity) scans newest-first across ALL grants.
  @@index([ok, createdAt])
  @@map("spend_ledger")
}

/// One auto-routed turn's decision + outcome — the routing engine's telemetry
/// (B14), so routing quality is observable over time. Privacy: NO full wallet,
/// NO raw question — engine-derived intent + service slugs only, mirroring the
/// /api/activity P1/P2 posture. Aggregated by /api/route/metrics.
model RouteEvent {
  id           String   @id @default(cuid())
  intent       String? // short engine intent, NOT the raw user question
  shortlisted  Int      @default(0) // candidate tools considered after retrieve→plan
  picks        Json? // [{ service, endpoint?, priceUsd }] chosen this turn
  settledCount Int      @default(0) @map("settled_count")
  failedCount  Int      @default(0) @map("failed_count")
  cachedCount  Int      @default(0) @map("cached_count")
  totalCostUsd Float    @default(0) @map("total_cost_usd")
  savedUsd     Float    @default(0) @map("saved_usd")
  latencyMs    Int      @default(0) @map("latency_ms")
  payer        String?
  blocked      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("route_events")
}

/// A deduplicated routing FAILURE — the self-heal loop's unit of work. Grouped
/// by `signature` (service + error class, e.g. "heurist-mesh:404") so repeated
/// failures of the same kind collapse into ONE incident with a count, not N
/// alerts. The state machine (open → dispatched → pr_open → resolved) is what
/// stops the autonomous fixer from firing twice for the same bug. `exampleTurnId`
/// links to the failing turn's full trace (route_trace_lines) — the "what the
/// user tried + what they got" the fix PR cites.
model RouteIncident {
  id           String    @id @default(cuid())
  signature    String    @unique // "<service-slug>:<errorClass>"
  service      String? // serviceName/host that failed
  errorClass   String?   @map("error_class") // "404" | "400" | "unresolved-path" | "settlement" | "timeout" | "error"
  title        String // human summary
  status       String    @default("open") // open | dispatched | pr_open | resolved | wontfix
  count        Int       @default(0)
  exampleTurnId String?  @map("example_turn_id") // a route_trace_lines turnId to view the trace
  lastError    String?   @map("last_error") // last error message (capped)
  prUrl        String?   @map("pr_url")
  firstSeenAt  DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  resolvedAt   DateTime? @map("resolved_at")

  @@index([status])
  @@index([lastSeenAt])
  @@map("route_incidents")
}

/// One directory toggle: a user flipped an agent into (`active=true`) or out of
/// (`active=false`) their chat runner. This mirrors the `agent_added` /
/// `agent_removed` Vercel Analytics events (lib/analytics.ts) into our own DB so
/// the admin adoption view can rank which agents get picked — data Vercel won't
/// hand back by slug. Privacy: NO full wallet — `address` is a lowercased wallet
/// when signed in, else null (guest toggles still count). Fire-and-forget write
/// (POST /api/agents/toggle); a failure never blocks the toggle.
model AgentToggleEvent {
  id        String   @id @default(cuid())
  slug      String // the McpServer.slug toggled (no FK: guests toggle static-catalog slugs too)
  active    Boolean // true = added to runner, false = removed
  address   String? // lowercased wallet if signed in, else null
  createdAt DateTime @default(now()) @map("created_at")

  @@index([slug])
  @@index([createdAt])
  @@map("agent_toggle_events")
}

/// One line of a routed turn's live reasoning trace — the public, realtime
/// stream behind the Activity page's routing terminal (and the chat engine
/// window). Unlike RouteEvent (one aggregate row per turn), this is the raw
/// line-by-line trace so a viewer can watch the engine think + pay in real time.
/// Privacy: SAME posture as /api/activity — engine-derived intent, service
/// slugs, prices, and public tx hashes only; NEVER a wallet or the raw question.
/// Written fire-and-forget from the chat SSE chokepoint (lib/route-trace.ts).
/// Local + prod share one Neon DB, so local test turns stream to prod too.
model RouteTraceLine {
  // Autoincrement so the public live feed can page with a simple `?since=<n>`
  // cursor (createdAt has ties within a turn).
  n         Int      @id @default(autoincrement())
  turnId    String   @map("turn_id") // groups the lines of one routed turn
  seq       Int      @default(0) // order within the turn
  type      String // status|analyze|shortlist|candidate|select|pay|receipt|tool|eip712|note|error
  event     Json // the RouterTraceEvent payload (matches lib/store RouterTraceEvent)
  txHash    String?  @map("tx_hash") // settled tx (receipt events) → BaseScan link
  payer     String? // 'burner' | 'agent' | 'wallet' | null
  createdAt DateTime @default(now()) @map("created_at")

  @@index([turnId])
  @@index([createdAt])
  @@map("route_trace_lines")
}

/// A bearer credential for headless agents (the `yeetful` SDK, scripts, CI).
/// The plaintext secret (`yf_…`) is shown ONCE at mint and only its sha256 is
/// stored; presenting it as `Authorization: Bearer yf_…` authenticates the
/// owner wallet on /api/grants* the same way a SIWE session cookie does.
model ApiKey {
  id           String    @id @default(cuid())
  ownerAddress String    @map("owner_address") // lowercased, SIWE-verified at mint
  /// Org scope; NULL = a personal key. Org keys are minted/managed by org
  /// admins and their spend rolls up to the org's daily cap.
  orgId        String?   @map("org_id")
  label        String    @default("API key")
  /// sha256 hex digest of the full plaintext secret.
  hash         String    @unique
  /// Display handle: the first 11 chars of the secret ("yf_" + 8), so the
  /// dashboard can say "yf_a1b2c3d4…" without storing anything recoverable.
  prefix       String
  /// Per-agent daily budget in USD. A key IS a connected agent (an app using
  /// the yeetful SDK); null = no agent-level budget, the grant alone governs.
  /// Advisory at the rails (the agent pays from its own wallet) — enforced by
  /// the SDK via /api/agent/policy and flagged on over-budget receipt syncs.
  perDayUsd    Float?    @map("per_day_usd")
  /// Kill switch: a reversible freeze (distinct from revoke = DELETE). When
  /// true, /api/agent/policy reports halted=AGENT_PAUSED and the SDK refuses
  /// all payments. Toggled SIWE-only (owner / org admin) — never by the key.
  paused       Boolean   @default(false)
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  org    Organization?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ledger SpendLedgerEntry[]

  @@index([ownerAddress])
  @@index([orgId])
  @@map("api_keys")
}

/// Per-wallet agent approval — the dashboard's "which agents may my account
/// pay" spec. Toggling syncs the owner's active SpendGrant allowlist (the
/// hosts of the approved services), so a toggle IS enforcement, not décor.
model AgentApproval {
  id           String  @id @default(cuid())
  ownerAddress String  @map("owner_address") // lowercased, SIWE-verified
  /// Org scope; NULL = personal. NOTE for item 2 (org-scoped approvals):
  /// the @@unique below must widen to [ownerAddress, serverId, orgId] when
  /// org approvals land, or a member's personal toggle collides with their
  /// org toggle for the same server. Left untouched here — item 1 is
  /// column-additive only.
  orgId        String? @map("org_id")
  serverId     String  @map("server_id")
  approved     Boolean @default(true)

  server    McpServer     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([ownerAddress, serverId])
  @@index([ownerAddress])
  @@index([orgId])
  @@map("agent_approvals")
}

/// A wallet's curated MCP shortlist — the 1–3 services they want to talk to
/// (the "pick your tools" direction). One row per wallet. Distinct from
/// AgentApproval (which agents may be *paid*) and from Chat.activeServerIds
/// (per-chat working set): the shortlist is the saved default that seeds a new
/// chat's active set. Empty / absent = no shortlist → current whole-catalog
/// behavior. Enforced ≤3 at the write layer (lib/shortlist.ts).
model McpShortlist {
  id           String   @id @default(cuid())
  ownerAddress String   @unique @map("owner_address") // lowercased, SIWE-verified
  serviceIds   String[] @map("service_ids") // McpServer ids, ordered, ≤3
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("mcp_shortlists")
}

/// A blog post — Neon holds the metadata + markdown; images live in Vercel
/// Blob (URLs only here). Published via the admin API (SIWE session or Bearer
/// yf_… key ∩ ADMIN_WALLETS) — the headless path Claude publishes through.
/// description doubles as the SEO meta description (keep ≤160 chars);
/// coverImageAlt exists because images without alt text don't rank.
model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  description   String
  content       String // markdown — rendered with raw HTML escaped
  coverImageUrl String?   @map("cover_image_url")
  coverImageAlt String?   @map("cover_image_alt")
  tags          String[]
  published     Boolean   @default(false)
  publishedAt   DateTime? @map("published_at")
  authorAddress String    @map("author_address") // lowercased admin wallet
  views         Int       @default(0) // page loads — bumped by POST /api/blog/[slug]/view
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([published, publishedAt])
  @@map("blog_posts")
}

// Landing-page "stay up to date" signups. Double opt-in: a row starts `pending`
// with a verification token emailed to the address; clicking the link flips it
// to `verified` (that's how we confirm the email is real).
model Subscriber {
  id         String    @id @default(cuid())
  email      String    @unique
  status     String    @default("pending") // 'pending' | 'verified'
  token      String    @unique // single-use verification token
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("subscribers")
}

// Price history for a launched MCP token's chart. There's no on-chain price
// history and Flaunch's OHLC API is unreliable, so we sample the v4-pool spot
// price ourselves (Flaunch SDK) and append a point — throttled — when the price
// endpoint is read. The chart reads this series.
model TokenPriceSample {
  id           String   @id @default(cuid())
  mcpSlug      String   @map("mcp_slug") // the launched McpServer.slug
  priceEth     String   @map("price_eth") // full-precision spot price (token in ETH)
  priceUsd     Float    @map("price_usd")
  marketCapUsd Float    @map("market_cap_usd")
  at           DateTime @default(now())

  @@index([mcpSlug, at])
  @@map("token_price_samples")
}

/// A wallet's paid plan (Stripe monthly billing). One row per owner address;
/// no row = the free tier. Stripe is the source of truth — rows are written
/// by the checkout/webhook flow (app/api/billing/*), never by hand.
model Subscription {
  id                   String    @id @default(cuid())
  ownerAddress         String    @unique @map("owner_address")
  plan                 String    @default("free") // PlanId: 'free' | 'growth' | 'scale'
  status               String    @default("active") // Stripe subscription status
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  currentPeriodEnd     DateTime? @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("subscriptions")
}

/// YEET credit movements — the inference token, ledgered off-chain today and
/// intended to become an ERC-20. Negative delta = spend (one house-model
/// answer), positive = a grant/top-up. The monthly plan allowance is NOT
/// ledgered: usage for a period is the sum of that period's debits, so the
/// allowance resets by construction each calendar month (UTC).
model CreditLedgerEntry {
  id           String   @id @default(cuid())
  ownerAddress String   @map("owner_address")
  delta        Int
  reason       String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([ownerAddress, createdAt])
  @@map("credit_ledger")
}

/// A PUBLIC embed key (`yfe_…`) — safe to ship in a host page's source, like
/// a Stripe publishable key. It does ONE thing: attributes embedded-chat
/// traffic (sites + YEET credit spend) to the owning account's plan. It is
/// NOT a bearer credential — it can read nothing and spend nothing beyond
/// metering the owner's own allowance. Minted/revoked from the dashboard.
model EmbedKey {
  id           String   @id @default(cuid())
  key          String   @unique // yfe_ + hex, stored plaintext (public by design)
  ownerAddress String   @map("owner_address")
  label        String   @default("")
  revoked      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([ownerAddress])
  @@map("embed_keys")
}

/// One row per (embed key, origin) that has mounted the chat — the "who has
/// embedded us where" ledger. Keyless embeds land under embedKeyId '' so the
/// adoption surface still sees anonymous origins. `pageUrl` keeps the most
/// recent full URL the SDK reported (referrer policy permitting); `turns`
/// counts chat messages sent from that origin.
model EmbedSite {
  id           String   @id @default(cuid())
  embedKeyId   String   @default("") @map("embed_key_id") // '' = keyless
  ownerAddress String?  @map("owner_address") // denormalized from the key
  origin       String
  pageUrl      String?  @map("page_url")
  turns        Int      @default(0)
  firstSeen    DateTime @default(now()) @map("first_seen")
  lastSeen     DateTime @default(now()) @map("last_seen")

  @@unique([embedKeyId, origin])
  @@index([ownerAddress])
  @@map("embed_sites")
}

/// One row per KEYED embedded-chat turn — the observability spine for the
/// self-healing loop. Records what visitors asked on a host site, what the
/// agent did about it (outcome), any transaction artifact it built, and the
/// explorer link once something was signed. Sessions (one id per embed
/// mount) make dead-end conversations computable: a session whose goal was
/// a transaction but that never reached tx-built/signed is the signal that
/// feeds "upgrade your MCP" suggestions. Keyless embeds record nothing —
/// telemetry is a feature OF the key.
model EmbedTurn {
  id           String   @id @default(cuid())
  embedKeyId   String   @map("embed_key_id")
  ownerAddress String?  @map("owner_address")
  origin       String
  sessionId    String   @map("session_id")
  prompt       String   @default("") // the visitor's ask, capped client+server side
  outcome      String // answered | clarify | tx-built | signed | refused | credit-gate | error
  artifact     String? // cow-order | tx | tx-chain | vote
  chain        String? // 'base' | 'ethereum' | a hex chainId — best-effort from the artifact
  detail       String? // short refusal/error text, or a human label for the artifact
  txUrl        String?  @map("tx_url") // explorer link once signed/placed
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([ownerAddress, createdAt])
  @@index([embedKeyId, createdAt])
  @@index([sessionId, createdAt])
  @@map("embed_turns")
}
